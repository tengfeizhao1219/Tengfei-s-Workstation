{
  "name": "smart-web-summary-extension",
  "version": "0.1.0",
  "description": "智能网页总结浏览器插件",
  "main": "src/background/service-worker.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,json,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,json,css,html}\"",
    "prepare": "husky install",
    "icons": "node scripts/generate-icons.js",
    "zip": "node scripts/create-zip.js"
  },
  "keywords": [
    "chrome-extension",
    "ai",
    "summary",
    "productivity",
    "browser-extension"
  ],
  "author": "Tengfei的小跟班 <tengfei@example.com>",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.0",
    "@types/chrome": "^0.0.250",
    "@types/jest": "^29.5.5",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "html-webpack-plugin": "^5.5.3",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.0.3",
    "style-loader": "^3.3.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.9.0"
  },
  "dependencies": {
    "axios": "^1.5.1",
    "dompurify": "^3.0.5",
    "marked": "^9.1.6"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tengfeizhao1219/Tengfei-s-Workstation.git",
    "directory": "projects/browser-extension"
  },
  "bugs": {
